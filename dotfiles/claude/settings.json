{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "default"
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "t=$(tmux display -p -t \"$TMUX_PANE\" '#{pane_tty}' 2>/dev/null); { printf '\\a' > \"${t:-/dev/tty}\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "plansDirectory": "./.claude/plans",
  "tui": "fullscreen",
  "autoMemoryDirectory": "./.claude/memory",
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true,
  "autoUpdates": false
}
